# Ultima — variables d'environnement (configurer dans Vercel, jamais committer .env).
# Ne JAMAIS committer de fichier .env réel : il est ignoré par .gitignore.

# URL du projet Supabase, ex. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Clé publique "anon" du projet Supabase (jamais la clé service_role).
SUPABASE_ANON_KEY=
