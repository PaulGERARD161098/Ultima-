diff --git a/lib/selectionPrix.ts b/lib/selectionPrix.ts
new file mode 100644
index 0000000..8ae01ff
--- /dev/null
+++ b/lib/selectionPrix.ts
@@ -0,0 +1,33 @@
+export type PrixFixe={vente_ht:number;unite:string;date:string};
+export type BanqueAchats={produits:{reference:string;achats:{achat_ht:number;date:string|null;unite:string|null;retenu:boolean}[];prix_fixe?:PrixFixe|null}[]};
+const age=(date:string,tarif:string)=>(Date.parse(date)-Date.parse(tarif))/86400000;
+const jourValide=(date:string)=>{
+  if(!/^\d{4}-\d{2}-\d{2}$/.test(date))return false;
+  const d=new Date(date+'T00:00:00Z');
+  return Number.isFinite(d.getTime())&&d.toISOString().slice(0,10)===date;
+};
+type Achat={achat_ht:number;date:string|null;unite:string|null;retenu:boolean};
+/** UN achat est-il utilisable au chiffrage du `date` ? La règle UNIQUE, appelée par
+ *  la sélection du prix et par tout compteur qui voudrait dire « prêt » : un compteur
+ *  qui recopierait le filtre dirait « prêt » le jour où le calcul, lui, refuserait. */
+export function achatUtilisable(a:Achat,date:string,validite:number,unite?:string|null):boolean{
+  return a.retenu&&!!a.unite&&(unite===undefined||a.unite===unite)&&!!a.date&&jourValide(a.date)&&jourValide(date)&&age(date,a.date)>=0&&age(date,a.date)<=validite&&Number.isFinite(a.achat_ht)&&a.achat_ht>0;
+}
+/** Un prix fixe (sans achat, fixé par l'artisan) se périme comme un achat : même validité. */
+export function prixFixeUtilisable(f:PrixFixe|null|undefined,date:string,validite:number,unite?:string|null):f is PrixFixe{
+  return !!f&&!!f.unite&&(unite===undefined||f.unite===unite)&&jourValide(f.date)&&jourValide(date)&&age(date,f.date)>=0&&age(date,f.date)<=validite&&Number.isFinite(f.vente_ht)&&f.vente_ht>0;
+}
+export type PrixSelectionne={nature:'achat';achatHT:number;date:string}|{nature:'fixe';venteHT:number;date:string}|{erreur:string};
+/** Une seule sélection pour la proposition et le recalcul serveur.
+ *  Deux montants retenus à la dernière date, ou achat + prix fixe, ne sont pas un prix utilisable. */
+export function selectionnerPrix(p:BanqueAchats['produits'][number],date:string,validite:number,unite:string|null|undefined):PrixSelectionne{
+  const achats=p.achats.filter(a=>achatUtilisable(a,date,validite,unite??null));
+  const fixe=p.prix_fixe;
+  if(prixFixeUtilisable(fixe,date,validite,unite??null)){
+    if(achats.length)return {erreur:'prix d’achat et prix fixe concurrents ; ce produit porte à la fois les deux. Choisissez-en un dans la bibliothèque.'};
+    return {nature:'fixe',venteHT:fixe.vente_ht,date:fixe.date};
+  }
+  const dernier=achats.map(a=>a.date!).sort().at(-1),retenus=achats.filter(a=>a.date===dernier);
+  if(!retenus.length||new Set(retenus.map(a=>a.achat_ht)).size!==1)return {erreur:'confirmez le prix d’achat daté et l’unité de ce produit dans la bibliothèque.'};
+  return {nature:'achat',achatHT:retenus[0].achat_ht,date:dernier!};
+}
