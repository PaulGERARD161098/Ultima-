+test('deux prix contradictoires à la même date ne donnent pas un prix utilisable',()=>{
+ const p={reference:'TEST-42',achats:[achat(1000),achat(1100)]};
+ assert.ok('erreur' in selectionnerPrix(p,date,90,'u'));
+});
+test('achat et prix fixe concurrents sont refusés',()=>{
+ const p={reference:'TEST-42',achats:[achat(1000)],prix_fixe:{vente_ht:1500,unite:'u',date:'2026-10-03'}};
+ const r=selectionnerPrix(p,date,90,'u');
+ assert.ok('erreur' in r&&/concurrents/.test(r.erreur));
+});
+test('un prix fixe seul est retenu tel quel',()=>{
+ const p={reference:'TEST-42',achats:[],prix_fixe:{vente_ht:30,unite:'u',date:'2026-10-03'}};
+ assert.deepEqual(selectionnerPrix(p,date,90,'u'),{nature:'fixe',venteHT:30,date:'2026-10-03'});
+});
+test('la dernière date tranche ; des copies identiques ne créent pas un conflit',()=>{
+ const p={reference:'TEST-42',achats:[achat(900,'2026-10-02'),achat(1000),achat(1000)]};
+ assert.deepEqual(selectionnerPrix(p,date,90,'u'),{nature:'achat',achatHT:1000,date:'2026-10-03'});
+});
+test('unités séparées : un conflit en u ne rend pas un prix en m indisponible',()=>{
+ const p={reference:'TEST-42',achats:[achat(1000),achat(1100),achat(100,'2026-10-03','m')]};
+ assert.ok('erreur' in selectionnerPrix(p,date,90,'u'));
+ assert.deepEqual(selectionnerPrix(p,date,90,'m'),{nature:'achat',achatHT:100,date:'2026-10-03'});
+ assert.ok('erreur' in selectionnerPrix(p,date,90,null));
+});
+test('une date impossible et une unité absente ne deviennent pas un tarif confirmé',()=>{
+ for(const d of ['2026-02-30','2026-13-01','2026-00-03']){
+  assert.equal(achatUtilisable(achat(1000,d),'2026-03-05',90),false);
+  assert.equal(prixFixeUtilisable({vente_ht:1000,unite:'u',date:d},'2026-03-05',90),false);
+ }
+ assert.equal(achatUtilisable(achat(1000,'2026-10-03',null),date,90,null),false);
+ assert.equal(achatUtilisable(achat(1000),'2026-02-30',90),false);
