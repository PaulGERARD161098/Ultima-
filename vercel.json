{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "ignoreCommand": "bash -c 'c=$(git diff --name-only HEAD^ HEAD)&&{ grep -qvxFf <(git ls-files -ci --exclude-from=.vercelignore) <<<\"$c\";[ $? = 1 ];}' && exit 0; exit 1",
  "redirects": [
    {
      "source": "/traveler",
      "destination": "/riven",
      "permanent": true
    },
    {
      "source": "/traveler.html",
      "destination": "/riven",
      "permanent": true
    },
    { "source": "/ultima", "destination": "/omega", "permanent": true },
    { "source": "/ultima.html", "destination": "/omega", "permanent": true },
    { "source": "/grima", "destination": "/omega", "permanent": true },
    { "source": "/grima.html", "destination": "/omega", "permanent": true },
    { "source": "/naga", "destination": "/imladrik", "permanent": true },
    { "source": "/tao", "destination": "/imladrik#constellation-dragons", "permanent": true },
    { "source": "/tao.html", "destination": "/imladrik#constellation-dragons", "permanent": true },
    { "source": "/naga.html", "destination": "/imladrik", "permanent": true },
    {
      "source": "/minethnir",
      "destination": "/maedrethnir",
      "permanent": true
    },
    {
      "source": "/minethnir.html",
      "destination": "/maedrethnir",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/finubar-matin",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/finubar-matin",
      "schedule": "0 6 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/leo-lv1-20260929": false
    }
  }
}
