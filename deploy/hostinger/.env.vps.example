# Copier ce fichier sur le VPS en `.env.vps` (droits 600) et remplir les valeurs.
# NE JAMAIS committer `.env.vps` dans Git.

# Domaine HTTPS pointant vers 191.215.46.50
# Exemple gratuit : un sous-domaine d'un domaine existant (leo.tondomaine.fr)
# ou l'hôte Hostinger srv2051208.hstgr.cloud
LEO_DOMAIN=srv2051208.hstgr.cloud

# Origines HTTPS autorisées à appeler l'API (URL de ton Ultima sur Vercel, séparées par virgule)
ALLOWED_ORIGINS=https://ton-ultima.vercel.app

# Supabase (projet Ultima)
SUPABASE_URL=https://leosfqyidgsaescjbfom.supabase.co
SUPABASE_ANON_KEY=

# Liste blanche des propriétaires autorisés (identique à Vercel)
ULTIMA_PROPRIETAIRES=

# Anthropic (plafond dur à configurer aussi dans la console Anthropic)
ANTHROPIC_API_KEY=
LEO_MODELE=claude-opus-4-8

# Garde-fou écritures automatiques : laisser 'coupees' tant que non validé
LEO_ECRITURES_AUTO=coupees
