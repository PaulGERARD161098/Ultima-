# Dépendances
node_modules/

# Variables d'environnement (secrets) — ne jamais committer
.env
.env.*
!.env.example

# Vercel
.vercel/

# Logs et divers
*.log
npm-debug.log*
.DS_Store

# Cache des harnais de test (fixtures npm, captures)
tests/.cache/
__pycache__/
*.py[cod]
# Registre technique privé de l'hôte Léo : jamais versionné.
leo/state/

# Métadonnées locales du CLI Supabase
supabase/.temp/

# Serveur « live » d’impeccable : fichiers d’exécution locaux (pid, port, JETON).
# Embarqué par erreur le 26/09 dans un commit jamais poussé, retiré avant push.
.impeccable/live/
# Archives de critique d'impeccable : locales ; la trace versionnée est le
# cadrage (CADRAGE-2026-09-25-carte-celeste.md §24), pas un second document.
.impeccable/critique/
